<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="com.kieronquinn.app.smartspacer.sdk.client,com.kieronquinn.app.smartspacer.sdk" />

    <application
        android:name=".SampleApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SampleHost">

        <!--
          宿主 Activity：LAUNCHER 是桌面图标，HOME+DEFAULT 才是系统默认桌面候选。
          AAR 里独立的 LawnchairLauncher 已 enabled=false，HOME 必须声明在这个宿主 Activity 上。
        -->
        <activity
            android:name=".SampleHostActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/AppLaunchTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SampleDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>
</manifest>
